# Optional: OpenAI-compatible LLM endpoint. Without these values the app uses
# a deterministic evidence summariser and clearly labels AI as disabled.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Optional: an HTTP endpoint returning the JSON schema documented in README.
FINANCE_API_URL=
FINANCE_API_KEY=

# Native Fuyao REST integration (https://fuyao.aicubes.cn/docs/).
# Keep this secret in local .env or deployment secrets, never in Git.
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn
